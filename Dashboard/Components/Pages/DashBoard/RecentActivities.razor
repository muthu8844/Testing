<div class="recent-activities-card h-100">
    <h3>Recent Activities</h3>
    <div class="timeline">
    @foreach (var item in activities)
    {
            <div class="timeline-item">
            <div class="time">@item.Time</div>
            <div class="icon-circle @item.Color">
                <i class="@item.Icon"></i>
            </div>

            <div class="activity-content">
                <div class="title">@item.Title</div>
                    <div class="subtitle"><b>@item.User</b> @item.Description</div>
               
            </div>
        </div>
    }
</div>
</div>

@code {
    private List<Activity> activities = new()
    {
        new Activity("Task Updated","Nikolai","Updated a Task","42 mins ago","bg-purple","fas fa-tasks"),
        new Activity("Deal Added","Panshi","Updated a Task","1 day ago","bg-pink","fa fa-bolt"),
        new Activity("Published Article","Rasel","Published an Article","42 mins ago","bg-blue","fas fa-book"),
        new Activity("Dock Updated","Reshmi","Updated a Dock","1 day ago","bg-yellow","fa fa-pencil"),
        new Activity("Replied Comment","Jenathon","Added a Comment","1 day ago","bg-green","fa fa-bolt")
    };

    public record Activity(string Title, string User,string Description, string Time, string Color, string Icon);
}