<div class="row g-3">

    <!-- Card 1: Revenue Status (Blue) -->
    <div class="col-lg-3 col-md-6">
        <div class="stat-card" style="background: #d9eefa;">

            <div class="metric-card-title">Revenue Status</div>
            <div class="d-flex justify-content-between align-items-center">
                @if (showSparkline)
                {
                    <ApexChart TItem="MetricBarChartData" Options="metricBarChartDataPrimaryOptions" Height="60" Width="100">
                        <ApexPointSeries TItem="MetricBarChartData"
                                         Items="metricBarChartDataPrimary"
                                         Name=""
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.X)"
                                         YValue="@(e => e.Y)" />
                    </ApexChart>
                }
                <div class="text-end">
                    <div class="stat-amount text-primary"><i class="fa fa-long-arrow-up"></i> $432</div>
                    <div class="stat-label">Jan 01 - Jan 10</div>
                </div>
            </div>

        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="stat-card h-100 d-flex flex-column"
             style="background: linear-gradient(135deg, #fef9e7, #fdeeba); overflow: hidden; position: relative; min-height: 130px;">

            <div style="position: relative; z-index: 1;">
                <div class="metric-card-title">Page View</div>
                <div class="stat-amount text-warning">
                    <i class="fa fa-long-arrow-up"></i> $432
                </div>
            </div>

            <!-- Chart absolutely positioned at bottom -->
            <div style="position: absolute; bottom: 0; left: 0; right: 0; z-index: 0;">
                @if (showSparkline)
                {
                    <ApexChart TItem="MetricBarChartData"
                               Options="metricAreaChartDataPrimaryOptions"
                               Height="80">
                        <ApexPointSeries TItem="MetricBarChartData"
                                         Items="metricAreaChartDataPrimary"
                                         Name=""
                                         SeriesType="SeriesType.Area"
                                         XValue="@(e => e.X)"
                                         YValue="@(e => e.Y)" />
                    </ApexChart>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card" style="background: linear-gradient(135deg, #fdecea, #fbd7d4);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="metric-card-title">Bounce Rate</div>
                    <div class="stat-amount text-danger"><i class="fa fa-long-arrow-up"></i> $432</div>
                    <select class="form-select form-select-sm w-auto mt-1">
                        <option>Monthly</option>
                        <option>Weekly</option>
                    </select>
                </div>

                @if (showSparkline)
                {
                    <div style="width: 120px; flex-shrink: 0;">
                        <ApexChart TItem="MetricBarChartData"
                                   Options="metricAreaChartDataSecondaryOptions"
                                   Height="60"
                                   Width="120">
                            <ApexPointSeries TItem="MetricBarChartData"
                                             Items="metricAreaChartDataSecondary"
                                             Name=""
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.X)"
                                             YValue="@(e => e.Y)" />
                        </ApexChart>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card" style="background: #f0dcff;">
            <div class="metric-card-title">Revenue Status</div>
            <div class="d-flex justify-content-between align-items-center">
                @if (showSparkline)
                {
                    <ApexChart TItem="MetricBarChartData" Options="metricBarChartDataSecondaryOptions" Height="60" Width="100">
                        <ApexPointSeries TItem="MetricBarChartData"
                                         Items="metricBarChartDataPrimary"
                                         Name=""
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.X)"
                                         YValue="@(e => e.Y)" />
                    </ApexChart>
                }
                <div class="text-end">
                    <div class="stat-amount text-primary" style="color:#a046f5!important"><i class="fa fa-long-arrow-up"></i> $432</div>
                    <div class="stat-label">Jan 01 - Jan 10</div>
                </div>
            </div>

        </div>
    </div>
</div>

